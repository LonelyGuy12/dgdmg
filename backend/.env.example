# ─── DataHub MCP ──────────────────────────────────────────────
# URL to your DataHub MCP server (leave blank to use mock)
DATAHUB_MCP_URL=https://your-datahub.acryl.io/api/mcp
DATAHUB_TOKEN=your_datahub_personal_access_token

# Set to "true" to use the built-in mock MCP catalog (no DataHub needed)
USE_MOCK_MCP=true

# ─── Groq ─────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
# Model to use (llama-3.3-70b-versatile is fast + capable, default)
GROQ_MODEL=llama-3.3-70b-versatile

# ─── GitHub ───────────────────────────────────────────────────
# Personal Access Token with repo scope
GITHUB_TOKEN=ghp_your_token_here
# Target repo in "owner/repo" format
GITHUB_REPO=your-org/dbt-analytics
# Path in the repo where dbt models live (no leading slash)
DBT_MODELS_PATH=models/marts
# Base branch to open PRs against
GITHUB_BASE_BRANCH=main

# ─── Server ───────────────────────────────────────────────────
PORT=8000
FRONTEND_URL=http://localhost:5173
